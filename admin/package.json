{
  "name": "tidewell-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:unauthorized": "node scripts/check-unauthorized.mjs",
    "test": "node --import tsx --test tests/authorization.test.ts tests/sales.test.ts tests/catalog.test.ts tests/customers.test.ts",
    "db:seed-sales": "node --env-file=.env.local --import tsx scripts/seed-demo-orders.ts",
    "db:test-catalog": "node --env-file=.env.local --import tsx scripts/check-catalog-crud.ts",
    "db:test-customers": "node --env-file=.env.local --import tsx scripts/check-users-shopping.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "tsx": "^4.15.0"
  }
}
