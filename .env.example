# AWS region where the table lives
AWS_REGION=eu-central-1
# Credentials: leave empty to use the default AWS provider chain
# (aws configure, SSO, IAM role). Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Single table used by the whole app
DYNAMODB_TABLE_NAME=tidewell-store
# Optional: point to DynamoDB Local (e.g. http://localhost:8000)
DYNAMODB_ENDPOINT=
